{% schema %}
{
  "name": "Video With Text",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top Margin",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom Margin",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "List Settings"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "List Dot Color",
      "default": "#4A90E2"
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "select",
      "id": "video_alignment",
      "label": "Video Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "video_cover",
      "label": "Video Cover Image"
    }
  ],
  "blocks": [
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "default": ""
        }
      ]
    },
    {
      "type": "heading_settings",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading_text",
          "label": "Heading Text",
          "default": "What Is Essential SFX",
          "info": "Separate words with spaces to color them individually"
        },
        {
          "type": "text",
          "id": "word_colors",
          "label": "Word Colors (comma-separated)",
          "default": "#FFFFFF,#FFFFFF,#FFFFFF,#4A90E2",
          "info": "Add colors separated by commas (e.g., #FFFFFF,#000000,#4A90E2)"
        },
        {
          "type": "range",
          "id": "heading_size_desktop",
          "label": "Font Size (Desktop)",
          "default": 40,
          "min": 20,
          "max": 80,
          "step": 2,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "heading_size_mobile",
          "label": "Font Size (Mobile)",
          "default": 28,
          "min": 16,
          "max": 50,
          "step": 2,
          "unit": "px"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "subheading_text",
          "label": "Subheading Text",
          "default": "Your subheading here"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Subheading Color",
          "default": "#9B9B9B"
        },
        {
          "type": "range",
          "id": "subheading_size_desktop",
          "label": "Font Size (Desktop)",
          "default": 18,
          "min": 14,
          "max": 40,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "subheading_size_mobile",
          "label": "Font Size (Mobile)",
          "default": 16,
          "min": 12,
          "max": 30,
          "step": 1,
          "unit": "px"
        }
      ]
    },
    {
      "type": "list_item",
      "name": "List Item",
      "settings": [
        {
          "type": "text",
          "id": "item_text",
          "label": "Item Text",
          "default": "List item text"
        },
        {
          "type": "range",
          "id": "text_size_desktop",
          "label": "Font Size (Desktop)",
          "default": 16,
          "min": 12,
          "max": 40,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "text_size_mobile",
          "label": "Font Size (Mobile)",
          "default": 14,
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video With Text",
      "blocks": [
        {
          "type": "heading_settings",
          "settings": {
            "heading_text": "What Is Essential SFX",
            "word_colors": "#FFFFFF,#FFFFFF,#FFFFFF,#4A90E2"
          }
        },
        {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class='custom-html-container'><p>Add your custom HTML or Liquid code here</p></div>"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "item_text": "Multi Software compatibility"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "item_text": "Live waveform previews (hear it live)"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "item_text": "Custom File uploads into the extension"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.video-with-text {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
  background: #000000;
}

.video-text-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  {% if section.settings.video_alignment == 'right' %}
    direction: rtl;
  {% endif %}
}

.video-container {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  border-radius: 8px;
}

.video-container iframe,
.video-container video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.text-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  {% if section.settings.video_alignment == 'right' %}
    direction: ltr;
    text-align: left;
  {% else %}
    text-align: left;
  {% endif %}
}

.heading-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 30px;
}

.heading-word {
  font-weight: 600;
}

.custom-html-container {
  margin: 20px 0;
}

.custom-liquid {
  margin-bottom: 30px;
}

.list-items {
  list-style: none;
  padding: 0;
  margin: 0;
}

.list-item {
  position: relative;
  padding-left: 20px;
  margin-bottom: 15px;
  color: #FFFFFF;
}

.list-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: {{ section.settings.dot_color }};
}

@media screen and (max-width: 768px) {
  .video-text-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .heading-container {
    margin-bottom: 20px;
  }
}
</style>

<div class="video-with-text">
  <div class="video-text-container">
    <div class="video-container">
      {% if section.settings.video_url != blank %}
        {% if section.settings.video_url.type == "youtube" %}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0&showinfo=0&controls=1&enablejsapi=1" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        {% elsif section.settings.video_url.type == "vimeo" %}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
        {% endif %}
      {% elsif section.settings.video_cover != blank %}
        <img src="{{ section.settings.video_cover | img_url: 'master' }}" alt="Video cover">
      {% endif %}
    </div>
    
    <div class="text-content">
      <div class="heading-container">
        {% for block in section.blocks %}
          {% if block.type == "heading_settings" %}
            {% assign words = block.settings.heading_text | split: ' ' %}
            {% assign colors = block.settings.word_colors | split: ',' %}
            {% for word in words %}
              <span class="heading-word" 
                    style="
                      color: {{ colors[forloop.index0] | default: colors.last }};
                      font-size: {{ block.settings.heading_size_desktop }}px;">
                {{ word }}
              </span>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        {% if block.type == "subheading" %}
          <div class="subheading"
               style="
                 color: {{ block.settings.subheading_color }};
                 font-size: {{ block.settings.subheading_size_desktop }}px;
                 margin-bottom: 30px;">
            {{ block.settings.subheading_text }}
          </div>
        {% endif %}
      {% endfor %}
      
      {% for block in section.blocks %}
        {% if block.type == "custom_liquid" %}
          <div class="custom-liquid">
            {{ block.settings.custom_liquid }}
          </div>
        {% endif %}
      {% endfor %}

      <ul class="list-items">
        {% for block in section.blocks %}
          {% if block.type == "list_item" %}
            <li class="list-item"
                style="font-size: {{ block.settings.text_size_desktop }}px;">
              {{ block.settings.item_text }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

{% style %}
@media screen and (max-width: 768px) {
  {% for block in section.blocks %}
    {% if block.type == "heading_settings" %}
      #shopify-section-{{ section.id }} .heading-word {
        font-size: {{ block.settings.heading_size_mobile }}px;
      }
    {% endif %}
    
    {% if block.type == "subheading" %}
      #shopify-section-{{ section.id }} .subheading {
        font-size: {{ block.settings.subheading_size_mobile }}px;
      }
    {% endif %}
    
    {% if block.type == "list_item" %}
      #shopify-section-{{ section.id }} .list-item:nth-child({{ forloop.index }}) {
        font-size: {{ block.settings.text_size_mobile }}px;
      }
    {% endif %}
  {% endfor %}
}
{% endstyle %}
