  ],
  "presets": [
    {
      "name": "Text with Boxes",
      "blocks": [
        {
          "type": "box",
          "settings": {
            "heading": "Creators You Love!",
            "subheading": "Over 800 Creator Joined World Wide"
          }
        },
        {
          "type": "box",
          "settings": {
            "heading": "Build Your Success!",
            "subheading": "Build your network, and get support"
          }
        },
        {
          "type": "box",
          "settings": {
            "heading": "Skills That Last Forever",
            "subheading": "This is not a one time skill, This is for life"
          }
        }
      ]
