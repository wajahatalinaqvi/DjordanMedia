        },
        {
          "type": "color",
          "id": "box_bg_to",
          "label": "Box Background Gradient To",
          "default": "#2A2A2A"
        },
        {
          "type": "range",
          "id": "box_bg_opacity",
          "label": "Box Background Opacity",
          "default": 90,
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%"
        },
        {
          "type": "color",
          "id": "box_border_from",
          "label": "Box Border Gradient From",
          "default": "#4A90E2"
        },
        {
          "type": "color",
          "id": "box_border_to",
          "label": "Box Border Gradient To",
          "default": "#9B9B9B"
        },
        {
          "type": "header",
          "content": "Icon Settings"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "color",
          "id": "icon_bg_from",
          "label": "Icon Background Gradient From",
          "default": "#4A90E2"
        },
        {
          "type": "color",
          "id": "icon_bg_to",
          "label": "Icon Background Gradient To",
          "default": "#9B9B9B"
        },
        {
          "type": "range",
          "id": "icon_bg_opacity",
          "label": "Icon Background Opacity",
          "default": 90,
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "Text Settings"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Box Heading",
          "default": "Creators You Love!"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Box Subheading",
          "default": "Over 800 Creator Joined World Wide"
        },
        {
          "type": "color",
          "id": "heading_color_from",
          "label": "Heading Gradient From",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "heading_color_to",
          "label": "Heading Gradient To",
          "default": "#9B9B9B"
        },
        {
          "type": "color",
          "id": "subheading_color_from",
          "label": "Subheading Gradient From",
          "default": "#9B9B9B"
        },
        {
          "type": "color",
          "id": "subheading_color_to",
          "label": "Subheading Gradient To",
          "default": "#4A90E2"
        },
        {
          "type": "range",
          "id": "heading_size_desktop",
          "label": "Heading Size (Desktop)",
          "default": 24,
          "min": 16,
          "max": 40,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "heading_size_mobile",
          "label": "Heading Size (Mobile)",
          "default": 20,
          "min": 14,
          "max": 32,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "subheading_size_desktop",
          "label": "Subheading Size (Desktop)",
          "default": 16,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "subheading_size_mobile",
          "label": "Subheading Size (Mobile)",
          "default": 14,
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px"
        }
      ]
