{% schema %}
{
  "name": "Gradient Heading",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "What You'll Get Inside The [gradient]Course![/gradient]",
      "info": "Use [gradient] and [/gradient] tags to mark which part of the text should have a gradient effect."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Font Size (Desktop)",
      "default": 48,
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "default": 36,
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Gradient Text Start Color",
      "default": "#D9D3B9"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Gradient Text End Color",
      "default": "#A39E8B"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Gradient Heading",
      "settings": {
        "heading_text": "What You'll Get Inside The [gradient]Course![/gradient]"
      }
    }
  ]
}
{% endschema %}

<style>
.gradient-heading-section {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
}

.gradient-heading-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: {{ section.settings.text_align }};
}

.gradient-heading {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.heading_size_desktop }}px;
  font-weight: 400;
  margin: 0;
  line-height: 1.3;
  color: {{ section.settings.heading_color }};
  text-transform: capitalize;
  letter-spacing: 0.5px;
}

@media screen and (max-width: 768px) {
  .gradient-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }
}
</style>

<div class="gradient-heading-section">
  <div class="gradient-heading-container">
    <h2 class="gradient-heading">
      {% render 'gradient-word-maker', 
        text: section.settings.heading_text,
        start_color: section.settings.gradient_from,
        end_color: section.settings.gradient_to
      %}
    </h2>
  </div>
</div>
