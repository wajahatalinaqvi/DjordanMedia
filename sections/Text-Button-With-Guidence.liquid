  ],
  "presets": [
    {
      "name": "Text Button With Guidance",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Step-by-Step Lessons in Adobe After Effects"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Creator Mindset & Workflow Training"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Speedramping & Viral Transitions"
          }
        },
        {
          "type": "feature",
          "settings": {
