    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get it!"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_bg_from",
      "label": "Button Background Gradient From",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "button_bg_to",
      "label": "Button Background Gradient To",
      "default": "#2A2A2A"
    },
    {
      "type": "color",
      "id": "button_border_from",
      "label": "Button Border Gradient From",
      "default": "#4A90E2"
    },
    {
      "type": "color",
      "id": "button_border_to",
      "label": "Button Border Gradient To",
      "default": "#9B9B9B"
    },
    {
      "type": "color",
      "id": "button_text_gradient_from",
      "label": "Button Text Gradient From",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_gradient_to",
      "label": "Button Text Gradient To",
      "default": "#CCCCCC"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Feature item"
        },
        {
          "type": "color",
          "id": "text_gradient_from",
          "label": "Text Gradient From",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "text_gradient_to",
          "label": "Text Gradient To",
          "default": "#CCCCCC"
