      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading Font Size (Mobile)",
      "default": 36,
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
