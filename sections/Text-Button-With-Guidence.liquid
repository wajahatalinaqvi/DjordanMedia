          "type": "feature",
          "settings": {
            "text": "Private Discord Community Access"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Trusted by Over 600 Creators Worldwide"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Lifetime Access & Free Future Updates"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Practice Footage Included"
          }
        }
      ]
    }
  ]
