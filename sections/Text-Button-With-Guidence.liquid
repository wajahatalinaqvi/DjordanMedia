{% endschema %}

<style>
.guidance-section {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background: #000000;
}

.guidance-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.text-side {
  text-align: left;
}

.guidance-heading {
  margin-bottom: 40px;
  text-align: left;
}

.main-heading {
  font-size: {{ section.settings.heading_size_desktop }}px;
  font-weight: 600;
  margin: 0;
  line-height: 1.2;
  background: linear-gradient(to right, {{ section.settings.heading_gradient_from }}, {{ section.settings.heading_gradient_to }});
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.subheading {
  font-size: {{ section.settings.subheading_size_desktop }}px;
  font-weight: 600;
  margin: 0;
  background: linear-gradient(to right, {{ section.settings.subheading_gradient_from }}, {{ section.settings.subheading_gradient_to }});
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.features-container {
  position: relative;
  padding: 40px;
  border-radius: 8px;
  background: linear-gradient(to right, rgba(26,26,26,0.9), rgba(42,42,42,0.9));
  z-index: 1;
}

.features-container::before {
  content: '';
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  z-index: -1;
  border-radius: 10px;
  background: linear-gradient(to right, {{ section.settings.button_border_from }}, {{ section.settings.button_border_to }});
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.features-grid-wrapper {
  display: grid;
  grid-template-columns: 1fr;
  gap: 30px;
}

.feature-group {
  display: contents;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 12px;
  color: {{ block.settings.text_color }};
}

.feature-item span {
  font-size: var(--feature-font-size, 16px);
}

.check-icon {
  width: 20px;
  height: 20px;
  min-width: 20px;
  fill: #4A90E2;
}

.button-container {
  text-align: left;
}

.guidance-button {
  display: inline-block;
  padding: 15px 40px;
  font-size: 16px;
  font-weight: 500;
  text-decoration: none;
  border-radius: 4px;
  background: linear-gradient(to right, {{ section.settings.button_bg_from }}, {{ section.settings.button_bg_to }});
  position: relative;
  z-index: 1;
  border: 2px solid transparent;
  background-clip: padding-box;
  transition: all 0.3s ease;
}

.guidance-button span {
  background: linear-gradient(to right, {{ section.settings.button_text_gradient_from }}, {{ section.settings.button_text_gradient_to }});
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.guidance-button::before {
  content: '';
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  z-index: -1;
  border-radius: 5px;
  background: linear-gradient(to right, {{ section.settings.button_border_from }}, {{ section.settings.button_border_to }});
}

.guidance-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

@media screen and (max-width: 768px) {
  .guidance-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  
  .features-container {
    padding: 30px 20px;
  }
  
  .features-grid-wrapper {
    gap: 0;
  }
  
  .features-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  
  .main-heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }
  
  .subheading {
    font-size: {{ section.settings.subheading_size_mobile }}px;
  }
  
  .guidance-heading {
    margin-bottom: 30px;
  }

  .feature-item span {
    font-size: var(--feature-font-size-mobile, 14px);
  }
}
</style>

<div class="guidance-section">
  <div class="guidance-container">
    <div class="text-side">
      <div class="guidance-heading">
        <h2 class="main-heading">{{ section.settings.heading_text }}</h2>
        <h2 class="subheading">{{ section.settings.subheading_text }}</h2>
      </div>

      {% if section.settings.button_text != blank %}
        <div class="button-container">
          <a href="{{ section.settings.button_url }}" class="guidance-button">
            <span>{{ section.settings.button_text }}</span>
          </a>
        </div>
      {% endif %}
    </div>

    <div class="features-container">
      <div class="features-grid-wrapper">
        <div class="features-grid">
          {% for block in section.blocks limit: 4 %}
            {% if block.type == "feature" %}
              <div class="feature-item" style="--feature-font-size: {{ block.settings.font_size_desktop }}px; --feature-font-size-mobile: {{ block.settings.font_size_mobile }}px;">
                <svg class="check-icon" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                </svg>
                <span style="background: linear-gradient(to right, {{ block.settings.text_gradient_from }}, {{ block.settings.text_gradient_to }}); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="features-grid">
          {% for block in section.blocks offset:4 %}
            {% if block.type == "feature" %}
              <div class="feature-item" style="--feature-font-size: {{ block.settings.font_size_desktop }}px; --feature-font-size-mobile: {{ block.settings.font_size_mobile }}px;">
                <svg class="check-icon" viewBox="0 0 24 24">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                </svg>
                <span style="color: {{ block.settings.text_color }}">{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
